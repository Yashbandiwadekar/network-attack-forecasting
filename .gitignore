data/*
!data/threat_intel/
checkpoints/
*.pt
*.pth
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Run logs from pipeline/training/benchmark scripts (regenerated on every run)
*.log
# Temp configs written by pipeline/build_ctu13_dataset.py
configs/_*.yaml
# Third-party publication used as source material for models/compliance.py — not ours to redistribute
certin_directions.txt
# Generated submission report (rebuilt from docs/, not a source file)
docs/CipherWraiths-Project-Report.pdf
# Builder/Auditor agent role instructions dropped into the repo root — not a project source file
Role.md

# NOTE: data/* above excludes the directory itself, so a negation like
# "!data/processed_real/metadata.json" cannot re-include anything under it. The two ~1 KB files the
# shipped demo genuinely needs are force-added instead (git add -f):
#   data/processed_real/scaler.npz     -- required to score with the real checkpoint
#   data/processed_real/metadata.json  -- read by app/_is_flow_only_model to decide whether to
#                                         zero-fill packet features (audit H11/W3); without it the
#                                         guard fails open in a fresh clone.

# Personal, machine-local Claude Code settings (permission rules). Never committed: this repo
# may be published, and these rules should not bind collaborators.
.claude/settings.local.json

# Runtime audit-ledger state written by the API at report time (per-deployment, not source)
checkpoints*/audit_ledger.jsonl

# Run logs, collected under logs/ rather than scattered across the repo root
logs/
