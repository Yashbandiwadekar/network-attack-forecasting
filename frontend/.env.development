# Split development only: Vite serves the UI on :5173 while the API runs on :8000, so the two are
# different origins and the frontend needs the API's absolute address. Vite loads this file
# automatically for `npm run dev` and ignores it for `npm run build`.
#
# The deployed build needs no equivalent: the API serves the dashboard itself, same origin.
VITE_API_BASE_URL=http://127.0.0.1:8000
